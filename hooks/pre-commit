#!/bin/sh
# ----------------------------------------------------------------------------
# Pre-commit hook: verify staged Java files are jfmt-formatted.
# Install with: ln -sf ../../hooks/pre-commit .git/hooks/pre-commit
# ----------------------------------------------------------------------------

set -eu

repo_root="$(git rev-parse --show-toplevel)"
jfmtw="$repo_root/jfmtw"

if [ ! -x "$jfmtw" ]; then
    echo "Warning: jfmtw not found or not executable, skipping format check" >&2
    exit 0
fi

# Collect staged Java files (Added, Copied, Modified)
staged_files="$(git diff --cached --name-only --diff-filter=ACM -- '*.java')"

if [ -z "$staged_files" ]; then
    exit 0
fi

# Resolve classpath (cached in target/, regenerated when pom.xml changes)
cp_cache="$repo_root/target/jfmt-classpath.txt"
pom_file="$repo_root/pom.xml"

if [ ! -f "$cp_cache" ] || [ "$pom_file" -nt "$cp_cache" ]; then
    mvn -f "$pom_file" dependency:build-classpath \
        -Dmdep.outputFile="$cp_cache" -q 2>/dev/null || true
fi

classpath=""
if [ -f "$cp_cache" ]; then
    classpath="$(cat "$cp_cache")"
fi

# Split staged files into main and test sources, check each with its source-path
main_files=""
test_files=""
for f in $staged_files; do
    case "$f" in
        src/main/java/*) main_files="$main_files $f" ;;
        src/test/java/*) test_files="$test_files $f" ;;
        *) ;; # ignore files outside src
    esac
done

failed=0

if [ -n "$main_files" ] && [ -n "$classpath" ]; then
    # shellcheck disable=SC2086
    if ! "$jfmtw" --source-path src/main/java --class-path "$classpath" --check $main_files 2>/dev/null; then
        failed=1
    fi
elif [ -n "$main_files" ]; then
    # shellcheck disable=SC2086
    if ! "$jfmtw" --check $main_files 2>/dev/null; then
        failed=1
    fi
fi

if [ -n "$test_files" ] && [ -n "$classpath" ]; then
    test_cp="$classpath:$repo_root/target/classes"
    # shellcheck disable=SC2086
    if ! "$jfmtw" --source-path src/test/java --class-path "$test_cp" --check $test_files 2>/dev/null; then
        failed=1
    fi
elif [ -n "$test_files" ]; then
    # shellcheck disable=SC2086
    if ! "$jfmtw" --check $test_files 2>/dev/null; then
        failed=1
    fi
fi

if [ "$failed" -ne 0 ]; then
    echo "" >&2
    echo "Commit rejected: some files are not formatted." >&2
    echo "Run:  ./jfmtw $staged_files" >&2
    exit 1
fi
