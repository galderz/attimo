#!/bin/sh
# ----------------------------------------------------------------------------
# Pre-commit hook: verify staged Java files are jfmt-formatted.
# The jfmtw wrapper auto-detects Maven classpath, so no flags needed here.
# ----------------------------------------------------------------------------

set -eu

repo_root="$(git rev-parse --show-toplevel)"
jfmtw="$repo_root/jfmtw"

if [ ! -x "$jfmtw" ]; then
    echo "Warning: jfmtw not found or not executable, skipping format check" >&2
    exit 0
fi

# Collect staged Java files (Added, Copied, Modified)
staged_files="$(git diff --cached --name-only --diff-filter=ACM -- '*.java')"

if [ -z "$staged_files" ]; then
    exit 0
fi

# shellcheck disable=SC2086
if ! "$jfmtw" --check $staged_files 2>/dev/null; then
    echo "" >&2
    echo "Commit rejected: some files are not formatted." >&2
    echo "Run:  ./jfmtw $staged_files" >&2
    exit 1
fi
